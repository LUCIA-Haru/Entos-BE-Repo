# =============================================================================
# Entos BE — environment variables (copy to .env and fill in)
# =============================================================================
# How to use:
#   1. cp .env.example .env
#   2. Edit .env with your local values
#   3. Never commit .env (it is gitignored)
#
# Tip (Myanmar / unstable networks): start with Docker Compose Postgres below
# before relying on a cloud database.
# =============================================================================

# --- Node / API ---
# development | test | production
NODE_ENV=development
# Port the Express API listens on
PORT=3000
# Public URL of this API (used later for auth callbacks / absolute links)
API_BASE_URL=http://localhost:3000

# --- CORS ---
# Comma-separated browser origins allowed to call the API.
# Leave * only for early local experiments; tighten before go-live.
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# --- Database (PostgreSQL) ---
# Matches docker-compose.yml defaults. Change if you use another Postgres.
DATABASE_URL=postgresql://entos:entos_dev_password@localhost:5432/entos?schema=public

# --- better-auth (placeholders — no real OAuth secrets required for scaffold) ---
# Generate a long random string for local sessions, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
# Must match where the auth handler is mounted (see apps/api auth routes)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (leave empty until you create a Google Cloud OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (leave empty until you create a Meta developer app)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email OTP provider (placeholder — wire a real provider later)
# Examples later: Resend, SMTP, etc. Empty = OTP sending is not configured yet.
EMAIL_FROM=noreply@entos.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
